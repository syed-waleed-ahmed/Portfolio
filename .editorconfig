# EditorConfig - keeps editors and IDEs aligned across platforms
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown allows trailing whitespace for line breaks
[*.md]
trim_trailing_whitespace = false

# Postman exports use tabs. Keeping that means re-exporting from Postman
# produces a clean diff instead of a whole-file reindent.
[*.postman_*.json]
indent_style = tab
indent_size = unset

# Lockfiles, minified files - leave as-is
[{package-lock.json,*.min.*}]
indent_size = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
