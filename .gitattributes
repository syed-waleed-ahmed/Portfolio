# Store text with LF and check it out with LF on every OS. `eol=lf` overrides
# core.autocrlf, so a Windows checkout gets LF too. A file an editor saves with
# CRLF is normalized on commit, so it produces no whole-file diff.
* text=auto eol=lf

# Explicit text files
*.js     text eol=lf
*.mjs    text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.css    text eol=lf
*.html   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.toml   text eol=lf
*.svg    text eol=lf
*.txt    text eol=lf
*.xml    text eol=lf

# Shell / Windows scripts keep their native endings
*.sh     text eol=lf
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binary assets - never touch these
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.webp   binary
*.avif   binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.eot    binary
*.pdf    binary

# GitHub linguist hints - generated files stay out of language stats, and their
# diffs start collapsed in pull requests
package-lock.json linguist-generated=true
frontend/src/data/github-activity.json linguist-generated=true

# Docs count as documentation, not as part of the project's language mix.
# (Postman JSON is deliberately not marked generated - collection diffs need
# to stay visible in review.)
docs/**           linguist-documentation=true
