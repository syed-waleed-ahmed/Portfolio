# Copy this file to backend/.env and fill in real values.
# NEVER commit the resulting .env file (it is already in .gitignore).
#
# Reference: ../docs/development.md#configuration

# Port the backend listens on. Render injects this automatically in production.
PORT=5000

# Set to `production` in deployed environments. It suppresses error detail in
# 500 responses, so a stack message never reaches a client.
NODE_ENV=development

# --- Email delivery (all three required) ---------------------------------
# Without these the API still serves every route, but POST /api/contact
# returns 503 instead of sending. Missing values are named in the boot log.

# API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Sender address. Must be on a domain verified with Resend, or
# onboarding@resend.dev while testing.
EMAIL_FROM=onboarding@resend.dev

# Recipient. Where contact-form submissions land.
EMAIL_TO=your-email@example.com

# --- Optional -------------------------------------------------------------

# Comma-separated browser origins allowed to call the API. Setting this
# REPLACES the built-in defaults (localhost:5173 plus the live domains)
# rather than adding to them.
# ALLOWED_ORIGINS=http://localhost:5173,https://syedwaleedahmed.me
