# =============================================================================
# Backend environment - TEMPLATE
# =============================================================================
# Copy to backend/.env and fill in real values:
#
#     cp backend/.env.example backend/.env
#
# backend/.env is gitignored and must never be committed. Every variable below
# is read once in config/env.js and exposed to the app as a frozen `config`
# object; nothing else in the backend touches process.env.
#
# Reference: ../docs/development.md#configuration
# -----------------------------------------------------------------------------


# --- Runtime -----------------------------------------------------------------

# Port the server listens on. Defaults to 5000 when unset. Render injects its
# own value in production, so leave this out of the Render dashboard.
PORT=5000

# `production` suppresses error detail in 500 responses, so a stack message
# never reaches a client. Use `development` locally to keep those messages.
NODE_ENV=development


# --- Email delivery (all three required) --------------------------------------
# Without these the API still boots and serves every route, but POST
# /api/contact returns 503 instead of sending. The missing names are listed in
# the boot log as `[env] missing: ...`.
#
# They are left empty on purpose. Any non-empty value counts as configured, so
# a placeholder copied unedited would turn the documented 503 into a 502 from
# a failed send, with no warning at boot.

# API key from https://resend.com, e.g. re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Sender address. Must be on a domain verified with Resend, or
# onboarding@resend.dev while testing. An unverified domain is the usual cause
# of a 502 from the contact endpoint.
EMAIL_FROM=

# Recipient. Where contact-form submissions land, e.g. you@example.com
EMAIL_TO=


# --- Optional -----------------------------------------------------------------

# Comma-separated browser origins allowed to call the API. Setting this
# REPLACES the built-in defaults rather than adding to them, so any origin you
# still need must be repeated here.
#
# Built-in defaults (config/env.js):
#   http://localhost:5173
#   https://syedwaleedahmed.netlify.app
#   https://syedwaleedahmed.me
#   https://www.syedwaleedahmed.me
#
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,https://syedwaleedahmed.me
