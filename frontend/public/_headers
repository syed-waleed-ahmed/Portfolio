/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# ===== Caching =====
# Read by Cloudflare, which serves the build (frontend/wrangler.jsonc). After a
# deploy, scripts/verify-deploy.mjs requests one URL per rule below and fails
# the deploy if the live site does not send these headers.
#
# HTML gets Cloudflare's default for assets, public, max-age=0,
# must-revalidate, so a deploy is visible on the next visit.

# The kill-switch for a service worker an old version of the site installed.
# Never cached, so a browser that still has the old worker finds this one.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
  Service-Worker-Allowed: /

# Fingerprinted bundle output: the name changes whenever the content does.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The font's file name changes whenever the font does.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Stable names (Profile.webp stays Profile.webp when the photo changes), so
# browsers revalidate rather than keep a stale copy.
/images/*
  Cache-Control: public, max-age=0, must-revalidate

/robots.txt
  Content-Type: text/plain; charset=utf-8

/.well-known/security.txt
  Content-Type: text/plain; charset=utf-8

/sitemap.xml
  Content-Type: application/xml; charset=utf-8
