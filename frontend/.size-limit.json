[
  {
    "name": "Entry JS (every visitor downloads this)",
    "path": "dist/assets/index-*.js",
    "gzip": true,
    "limit": "87 kB"
  },
  {
    "name": "Entry CSS",
    "path": "dist/assets/index-*.css",
    "gzip": true,
    "limit": "8 kB"
  },
  {
    "name": "Skill marks sprite, one cached image request",
    "path": "dist/assets/skill-icons-*.svg",
    "gzip": true,
    "limit": "23 kB"
  },
  {
    "name": "Command palette chunk (cmdk), fetched on intent",
    "path": ["dist/assets/CommandPalette-*.js", "dist/assets/CommandPalette-*.css"],
    "gzip": true,
    "limit": "20 kB"
  },
  {
    "name": "Contribution graph chunks (react-activity-calendar), fetched near the viewport",
    "path": ["dist/assets/GitHubActivityCalendar-*.js", "dist/assets/Tooltip-*.js"],
    "gzip": true,
    "limit": "27 kB"
  },
  {
    "name": "Globe chunk (cobe), fetched near the viewport on wide screens",
    "path": "dist/assets/index.esm-*.js",
    "gzip": true,
    "limit": "6.5 kB"
  }
]
