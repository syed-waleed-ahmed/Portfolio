[
  {
    "name": "Entry JS (every visitor downloads this)",
    "path": "dist/assets/index-*.js",
    "gzip": true,
    "limit": "87 kB"
  },
  {
    "name": "Entry CSS, the stylesheet the first screen waits for",
    "path": "dist/assets/index-*.css",
    "gzip": true,
    "limit": "6 kB"
  },
  {
    "name": "Section styles, linked after the hero, block only what follows",
    "path": "dist/assets/sections-*.css",
    "gzip": true,
    "limit": "4.5 kB"
  },
  {
    "name": "Print stylesheet, media=print, never blocks rendering",
    "path": "dist/assets/print-*.css",
    "gzip": true,
    "limit": "1 kB"
  },
  {
    "name": "Skill marks sprite, one cached image request",
    "path": "dist/assets/skill-icons-*.svg",
    "gzip": true,
    "limit": "23 kB"
  },
  {
    "name": "Project pictures, the fourteen AVIF files, loaded lazily, never all by one screen",
    "path": "dist/assets/*.avif",
    "gzip": true,
    "limit": "238 kB"
  },
  {
    "name": "Project pictures, the WebP fallbacks",
    "path": "dist/assets/*.webp",
    "gzip": true,
    "limit": "305 kB"
  },
  {
    "name": "Command palette chunk (cmdk), fetched on intent",
    "path": ["dist/assets/CommandPalette-*.js", "dist/assets/CommandPalette-*.css"],
    "gzip": true,
    "limit": "20 kB"
  },
  {
    "name": "Contribution graph chunks (react-activity-calendar), fetched near the viewport",
    "path": ["dist/assets/GitHubActivityCalendar-*.js", "dist/assets/GitHubActivityCalendar-*.css", "dist/assets/Tooltip-*.js"],
    "gzip": true,
    "limit": "27 kB"
  },
  {
    "name": "Globe chunk (cobe), fetched near the viewport on wide screens",
    "path": "dist/assets/index.esm-*.js",
    "gzip": true,
    "limit": "6.5 kB"
  }
]
