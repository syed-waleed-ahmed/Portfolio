# Copy this file to frontend/.env (already gitignored) to override values for
# local development. In production these are set in Netlify's UI.
#
# Reference: ../docs/development.md#configuration
#
# WARNING: every VITE_-prefixed variable is compiled into the public client
# bundle. Never put a secret here.

# Backend base URL. Unset, the app falls back to the deployed Render backend,
# so set this when you want the contact form to hit your local API.
VITE_API_BASE_URL=http://localhost:5000
