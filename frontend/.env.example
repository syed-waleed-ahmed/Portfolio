# =============================================================================
# Frontend environment - TEMPLATE
# =============================================================================
# Copy to frontend/.env for local development:
#
#     cp frontend/.env.example frontend/.env
#
# frontend/.env is gitignored. In production these values are set in the
# Netlify UI instead, and the file is not deployed.
#
# WARNING: every VITE_-prefixed variable is inlined into the public client
# bundle at build time and is readable by anyone who loads the site. Never put
# a secret, key or token in this file.
#
# Reference: ../docs/development.md#configuration
# -----------------------------------------------------------------------------


# Backend base URL used by the contact form. Left unset, the app falls back to
# the deployed Render backend baked into Contact.jsx, so set this when you want
# the form to hit a backend you are running locally.
#
# Must match the port the backend is actually listening on (PORT in
# backend/.env, 5000 by default).
VITE_API_BASE_URL=http://localhost:5000
