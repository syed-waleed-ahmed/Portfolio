{
  "name": "frontend",
  "version": "4.0.0",
  "private": true,
  "description": "Portfolio frontend (React 19 + Vite, prerendered at build time)",
  "type": "module",
  "author": "Syed Waleed Ahmed",
  "license": "MIT",
  "homepage": "https://syedwaleedahmed.me/",
  "repository": {
    "type": "git",
    "url": "https://github.com/syed-waleed-ahmed/Portfolio.git",
    "directory": "frontend"
  },
  "engines": {
    "node": "^22.19.0 || ^24.5.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler dev --port 8787",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prebuild": "eslint . && tsc --noEmit -p tsconfig.json && npm test && node --test ../test/invariants.test.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "size": "size-limit",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.ts\" \"worker/test/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "cmdk": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@size-limit/file": "^14.3.0",
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "size-limit": "^14.3.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
