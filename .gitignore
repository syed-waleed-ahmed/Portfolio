# === Dependencies ===
# frontend/ and backend/ each keep their own. The root can get one too, from the
# `npm i --no-save` that scripts/gen-og-card.mjs needs.
node_modules/
# The root package.json only holds delegating scripts and has no dependencies,
# so a lockfile here can only come from a stray `npm install`.
/package-lock.json

# === Build output ===
dist/
# SSR bundle used by frontend/scripts/prerender.mjs; removed after each build,
# so it only survives one that failed
dist-server/

# === Tool caches ===
.vite/
.eslintcache
.cache/

# === Env / secrets ===
# No slash, so these match at any depth, including backend/ and frontend/.
.env
.env.*
# But DO track .env.example templates - they're checked-in placeholders
!.env.example

# === Logs ===
npm-debug.log*
logs/
*.log

# === Editor / IDE ===
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.sw?
*.local

# === Local AI / agent files ===
# CLAUDE.md is shared project guidance and stays trackable; these are per-machine.
.claude/
CLAUDE.local.md

# === graphify knowledge graph ===
# Fully ignored: everything here is regenerable output, not project source.
graphify-out/
.graphify_*

# === Secrets / keys / certificates (live app - never commit these) ===
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
*.keystore
id_rsa
id_rsa.*
secrets.json
.secrets/

# === Deployment / platform artifacts ===
.netlify/
.render/

# === Test / coverage output ===
coverage/
*.lcov
# newman writes HTML/JSON run reports here when reporters are enabled
newman/
# Playwright's report and per-test traces, from npm run test:e2e
playwright-report/
test-results/

# === OS ===
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.bak
