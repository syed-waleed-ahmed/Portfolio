{
  "name": "portfolio",
  "version": "3.0.0",
  "private": true,
  "description": "Portfolio of Syed Waleed Ahmed: a prerendered React and TypeScript site with engineering case studies, and a Cloudflare Worker for the contact form.",
  "type": "module",
  "author": "Syed Waleed Ahmed",
  "license": "MIT",
  "homepage": "https://syedwaleedahmed.me/",
  "repository": {
    "type": "git",
    "url": "https://github.com/syed-waleed-ahmed/Portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/syed-waleed-ahmed/Portfolio/issues"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "install:all": "npm ci --prefix frontend",
    "dev": "npm --prefix frontend run dev",
    "dev:api": "npm --prefix frontend run dev:api",
    "lint": "npm --prefix frontend run lint",
    "typecheck": "npm --prefix frontend run typecheck",
    "test": "npm --prefix frontend test && npm run test:invariants",
    "test:invariants": "node --test test/invariants.test.ts",
    "build": "npm --prefix frontend run build",
    "test:e2e": "npm --prefix frontend run test:e2e"
  }
}
