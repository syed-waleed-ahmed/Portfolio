{
  "name": "portfolio",
  "version": "2.1.1",
  "private": true,
  "description": "Personal portfolio - React 19 + Vite frontend, Node + Express backend.",
  "type": "module",
  "author": "Syed Waleed Ahmed",
  "license": "MIT",
  "homepage": "https://syedwaleedahmed.me/",
  "repository": {
    "type": "git",
    "url": "https://github.com/syed-waleed-ahmed/Portfolio.git"
  },
  "bugs": {
    "url": "https://github.com/syed-waleed-ahmed/Portfolio/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:all": "npm install --prefix frontend && npm install --prefix backend",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "test": "npm --prefix backend test",
    "test:invariants": "node --test test/invariants.test.js",
    "start": "npm --prefix backend start"
  }
}
